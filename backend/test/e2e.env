# The settings of every e2e test run. They win over backend/.env (which still gives the database
# address, password and JWT_SECRET). Read by setup-env.ts, and by e2e-external.sh for a backend it starts.

# The test database, never your real tasks
DB_NAME=taskboard_test

# The tests log in many times per run, which would hit the login rate limit.
# The 'rate limits' test switches it back on to prove it works.
DISABLE_RATE_LIMIT=true

# The backend talks to the fake Claude in fake-claude.ts, never the real one: no cost, same answers every run.
# The key is a made-up one, so a mistake can't reach the real API with your key.
FAKE_CLAUDE_PORT=4010
ANTHROPIC_BASE_URL=http://127.0.0.1:4010
ANTHROPIC_API_KEY=fake-key-for-the-tests

# Look for files of deleted tasks every 200 ms instead of every hour, so the clean-up test doesn't wait
ATTACHMENT_CLEANUP_EVERY_MS=200
